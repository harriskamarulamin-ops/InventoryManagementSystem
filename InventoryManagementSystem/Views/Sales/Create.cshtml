@section Title {
    New Sale
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-success">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Sales Checkout Terminal</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Select Checkout Item</label>
                        <select name="productId" class="form-select" asp-items="ViewBag.Products" required>
                            <option value="">-- Choose Product --</option>
                        </select>
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label fw-bold">Quantity to Sell</label>
                        <input name="quantitySold" type="number" min="1" class="form-control" placeholder="1" default="1" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4">Complete Order & Generate Invoice</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>