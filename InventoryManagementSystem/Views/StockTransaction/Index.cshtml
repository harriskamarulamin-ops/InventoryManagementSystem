@model IEnumerable<InventoryManagementSystem.Models.StockTransaction>
@section Title {
    Stock History
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h2>Stock Ledger History</h2>
    <a asp-action="Create" class="btn btn-dark">+ Log Stock Adjustment</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Date & Time</th>
                    <th>Product Item</th>
                    <th>Adjustment Type</th>
                    <th>Quantity Impact</th>
                    <th>Remarks / Notes</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No stock modifications logged yet.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TransactionDate.ToString("g")</td>
                        <td class="fw-bold">@item.Product?.Name</td>
                        <td>
                            <span class="badge @(item.Type == "IN" ? "bg-success" : "bg-danger")">
                                @item.Type
                            </span>
                        </td>
                        <td class="fw-bold @(item.Type == "IN" ? "text-success" : "text-danger")">
                            @(item.Type == "IN" ? "+" : "-")@item.Quantity
                        </td>
                        <td>@item.Remarks</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>