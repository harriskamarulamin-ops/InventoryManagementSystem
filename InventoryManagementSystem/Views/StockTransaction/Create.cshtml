@model InventoryManagementSystem.Models.StockTransaction
@section Title {
    Log Adjustment
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Log Inventory Flow</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Select Inventory Item</label>
                        <select name="productId" class="form-select" asp-items="ViewBag.Products" required>
                            <option value="">-- Choose Product --</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Type" class="form-label fw-bold">Transaction Type</label>
                        <select asp-for="Type" class="form-select" required>
                            <option value="IN">Stock In (+ Incoming Supply)</option>
                            <option value="OUT">Stock Out (- Shrinkage/Damaged/Manual Drop)</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Quantity" class="form-label fw-bold">Impact Quantity</label>
                        <input asp-for="Quantity" type="number" min="1" class="form-control" placeholder="Minimum 1 item" required />
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Remarks" class="form-label fw-bold">Remarks / Explanatory Reason</label>
                        <input asp-for="Remarks" class="form-control" placeholder="e.g., Weekly Restock, Broken item batch" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Back to Ledger</a>
                        <button type="submit" class="btn btn-dark px-4">Apply Adjustment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>