@model InventoryManagementSystem.Models.Category
@section Title {New Category}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Create New Category</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method"post">
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Category Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Electronics, Consumables" required/>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter category context details..."></textarea>
                    </div>
          
                    <div class="d-flex justify-content-end">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <button type="submit" class="btn btn-primary px-4">Save Category</button>
                    </div>
                </form>
             </div>
         </div>
     </div>
</div>
