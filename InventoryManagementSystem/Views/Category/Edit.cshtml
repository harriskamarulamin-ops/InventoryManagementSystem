@model InventoryManagementSystem.Models.Category
@section Title {
    Edit Category
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0" style="border-radius: 12px;">
            <div class="card-header bg-dark text-white p-3" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                <h4 class="mb-0 fw-bold">Edit Category</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-secondary">Category Name *</label>
                        <input asp-for="Name" class="form-control p-2.5" style="border-radius: 8px;" required />
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Description" class="form-label fw-bold text-secondary">Description *</label>
                        <input asp-for="Description" class="form-control p-2.5" style="border-radius: 8px;" required />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4" style="border-radius: 6px;">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4" style="border-radius: 6px;">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>