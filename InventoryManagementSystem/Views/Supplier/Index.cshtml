@model IEnumerable<InventoryManagementSystem.Models.Supplier>
@section Title {
    Suppliers
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h2>Warehouse Suppliers</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add New Supplier</a>
    }
</div>

<div class="row mb-4">
    <div class="col-md-6 col-lg-4">
        <form method="get" class="d-flex">
            <input type="text" name="searchTerm" class="form-control me-2" placeholder="Search by ID, Name, Address or Phone..." value="@ViewBag.SearchTerm" />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-2 text-decoration-none">Clear</a>
            }
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 10%">ID</th>
                    <th style="width: 25%">Supplier Name</th>
                    <th style="width: 25%">Address</th>
                    <th style="width: 25%">Phone</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th style="width: 15%" class="text-center">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@(User.IsInRole("Admin") ? "5" : "4")" class="text-center text-muted py-4">No suppliers listed yet.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="fw-bold">@item.Name</td>
                        <td>@item.ContactAddress</td>
                        <td>@item.PhoneNumber</td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this supplier?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>