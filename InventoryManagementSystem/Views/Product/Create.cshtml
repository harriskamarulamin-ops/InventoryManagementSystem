@model InventoryManagementSystem.Models.Product
@section Title {
    Add Product
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Add Item to Inventory</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-12 form-group mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Product Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., ThinkPad T14" required />
                        </div>

                        <div class="col-md-12 form-group mb-3">
                            <label asp-for="Variant" class="form-label fw-bold">Variant</label>
                            <input asp-for="Variant" class="form-control" placeholder="e.g Special Edition" required />
                        </div>


                        <div class="col-md-6 form-group mb-3">
                            <label class="form-label fw-bold">Category</label>
                            <select name="categoryId" class="form-select" asp-items="ViewBag.Categories" required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>

                        <div class="col-md-6 form-group mb-3">
                            <label class="form-label fw-bold">Supplier</label>
                            <select name="supplierId" class="form-select" asp-items="ViewBag.Suppliers" required>
                                <option value="">-- Select Supplier --</option>
                            </select>
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="CostPrice" class="form-label fw-bold">Unit Price</label>
                            <input asp-for="CostPrice" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="RetailPrice" class="form-label fw-bold">Retail Price</label>
                            <input asp-for="RetailPrice" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="CurrentStock" class="form-label fw-bold">Initial Stock Level</label>
                            <input asp-for="CurrentStock" type="number" step="1" class="form-control" placeholder="0" required />
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="MinStockThreshold" class="form-label fw-bold">Minimum Stock Alert Threshold</label>
                            <input asp-for="MinStockThreshold" type="number" step="1"class="form-control" placeholder="5" required />
                        </div>
                    </div>
                  

                    <div class="d-flex justify-content-between mt-2">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <button type="submit" class="btn btn-primary px-4">Save Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>