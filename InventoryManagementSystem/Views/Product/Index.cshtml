@model IEnumerable<InventoryManagementSystem.Models.Product>
@section Title {
        Products
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h2>Inventory Master List</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add New Product</a>
    }
</div>

<div class="row mb-4">
    <div class="col-md-6 col-lg-6">
        <form method="get" class="d-flex">
            <input type="text" name="searchTerm" class="form-control me-2" placeholder="Search by ID, Name, Variant, Category or Supplier..." value="@ViewBag.SearchTerm" />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-2 text-decoration-none">Clear</a>
            }
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Variant</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>Stock Levels</th>
                    <th>Cost Price</th>
                    <th>Retail Price</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th class="text-center">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@(User.IsInRole("Admin") ? "9" : "8")" class="text-center text-muted py-4">Warehouse is empty. Add your first product!</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.Name</td>
                            <td class="text-muted">@item.Variant</td>

                            <td>@(item.Category?.Name ?? "Uncategorized")</td>
                            <td>@(item.Supplier?.Name ?? "Unknown Vendor")</td>

                            <td>
                                <span class="badge @(item.CurrentStock <= item.MinStockThreshold ? "bg-danger text-white fw-bold text-uppercase" : "bg-success")">
                                    @item.CurrentStock / @item.MinStockThreshold (Min)
                                </span>
                            </td>

                            <td>RM @item.CostPrice.ToString("0.00")</td>
                            <td>RM @item.RetailPrice.ToString("0.00")</td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1">Edit</a>
                                   <button type="button" 
                                            class="btn btn-outline-danger btn-sm btn-delete" 
                                            data-id="@item.Id" 
                                            data-name="@item.Name" 
                                            data-url="@Url.Action("Delete", new { id = item.Id })">
                                            Delete </button>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>