@section Title {Login}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-11">
            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="row g-0">
                    <!-- Left side: Image Pane -->
                    <div class="col-md-6 d-none d-md-block" style="background-image: url('/images/logo.png'); background-size: cover; background-position: center; min-height: 450px;">
                    </div>
                    <!-- Right side: Form Pane -->
                    <div class="col-md-6 col-12 d-flex flex-column justify-content-center bg-white">
                        <div class="card-header bg-white border-0 text-center pt-4">
                            <h4 class="fw-bold mb-0 text-primary">Inventory Management Portal</h4>
                        </div>
                        <div class="card-body px-4 py-3">
                            <form asp-action="Login" method="post">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                                <div class="mb-3">
                                    <label class="form-label font-weight-bold small text-muted">Email Address</label>
                                    <input name="email" type="email" class="form-control" placeholder="Enter email address" data-val="true" data-val-required="Email is required." />
                                    <span class="text-danger small" data-valmsg-for="email" data-valmsg-replace="true"></span>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label font-weight-bold small text-muted">Password</label>
                                    <input name="password" type="password" class="form-control" placeholder="Enter password" data-val="true" data-val-required="Password is required." />
                                    <span class="text-danger small" data-valmsg-for="password" data-valmsg-replace="true"></span>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 py-2">Sign In</button>
                            </form>
                        </div>
                        <div class="card-footer text-center py-3 bg-light border-0">
                            <a asp-action="Register" class="text-decoration-none text-muted small">Need an account? Register here</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}